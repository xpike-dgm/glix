# ==============================================================================
# Glix Server Environment Configuration (Direct / Development / Testing)
# ==============================================================================

HOST=0.0.0.0
PORT=8787

# Comma-separated list of allowed browser origins for WebSocket connections.
# Example: http://localhost:5173,http://localhost:18080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:18080

# Whether to allow WebSocket connections without an Origin header.
# Defaults to true in development/test, false in NODE_ENV=production.
ALLOW_NO_ORIGIN=true

# Number of trusted reverse proxy hops.
# Set to 0 if clients connect directly to Node without reverse proxy.
# Set to 1 if behind a single reverse proxy (e.g., Nginx, Cloudflare, Traefik).
# Set to 2 if behind two reverse proxies (e.g., Host TLS Proxy -> Container Nginx -> Node).
TRUSTED_PROXY_HOPS=0

# Maximum allowed WebSocket payload in bytes.
# Default: 2097152 (2 MiB). Must be >= 1217065 (worst-case karalama-defteri drawing).
MAX_PAYLOAD_BYTES=2097152
