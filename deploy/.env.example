# Copy this file to deploy/.env on the Ubuntu VDS.
# Values that contain example.invalid are placeholders and must be replaced
# before a public deployment.

GLIX_COMPOSE_PROJECT_NAME=glix-party
GLIX_SERVER_IMAGE=glix-party-server:local
GLIX_CLIENT_IMAGE=glix-party-client:local

# Publish the edge only on loopback so a host-level TLS reverse proxy can own
# the public domain and certificate.
GLIX_BIND_ADDRESS=127.0.0.1
GLIX_HTTP_PORT=18080

# Internal Node/WebSocket service settings. Keep the server private to the
# Compose network; Nginx reaches it as glix-server:8787.
GLIX_SERVER_HOST=0.0.0.0
GLIX_SERVER_PORT=8787

# Documentation/configuration values for the future Glix hostname.
# These do not change the existing api.lynrax.com or game.lynrax.com services.
GLIX_DOMAIN=glix.example.invalid
GLIX_PUBLIC_ORIGIN=https://glix.example.invalid
