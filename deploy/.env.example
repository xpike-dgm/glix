# ==============================================================================
# Glix Production Docker Compose Environment Configuration
# Copy this file to `deploy/.env` and adjust the values for your deployment.
# ==============================================================================

# Compose Project
GLIX_COMPOSE_PROJECT_NAME=glix-party
GLIX_SERVER_IMAGE=glix-party-server:local
GLIX_CLIENT_IMAGE=glix-party-client:local

# Published Host Bindings (Client edge Nginx loopback)
GLIX_BIND_ADDRESS=127.0.0.1
GLIX_HTTP_PORT=18080

# Internal Server Settings
GLIX_SERVER_HOST=0.0.0.0
GLIX_SERVER_PORT=8787

# ------------------------------------------------------------------------------
# Security & Hardening Configuration
# ------------------------------------------------------------------------------

# Comma-separated list of allowed browser origins for WebSocket connections.
# In production, this MUST match your public domain (e.g. https://glix.example.com).
# If empty in production, connections with an Origin header not matching will be rejected.
GLIX_ALLOWED_ORIGINS=https://glix.example.com

# Whether to allow WebSocket connections without an Origin header (e.g., native tools, curl).
# Recommended: false in production, true in local/development environments.
GLIX_ALLOW_NO_ORIGIN=false

# Number of trusted reverse proxy hops between client and glix-server.
# glix-server is behind the client Nginx container (hop 1).
# If you have an additional host reverse proxy (e.g., Caddy or host Nginx with TLS),
# set this to 2 so client IP extraction inspects the correct rightmost hop.
# Default: 1 (only container Nginx). Set to 2 if Host Proxy -> Container Nginx -> glix-server.
GLIX_TRUSTED_PROXY_HOPS=1

# Maximum WebSocket payload size in bytes.
# Default: 2097152 (2 MiB). Bounded to protect server memory against oversized frames.
# Legal worst-case drawing in karalama-defteri is measured at ~1.21 MiB.
GLIX_MAX_PAYLOAD_BYTES=2097152
